{
  // Copy this file to config.json (which is not committed) and point it to your copy of
  // Wing Commander (the GOG "Wing Commander 1+2" install or its GAMEDAT folder).
  // Windows paths need doubled backslashes; forward slashes work on every platform.
  "gameDirectory": "C:/GOG Games/Wing Commander",

  // Everything below is optional: the game writes it when you change the settings in the
  // pause menu (Esc). Saving rewrites the file without these comments.
  "audio": { "musicVolume": 10, "soundVolume": 10 },          // 0..10
  "display": {
    "fullscreen": false,
    "filter": "sharp",                                       // sharp, nearest, linear
    "aspect": "4:3",                                         // 4:3 or square
    "integerScaling": false,
    "vsync": true
  },
  "text": { "sharp": true, "modernFonts": true },             // text at screen resolution, replacement fonts
  "interface": { "keyHelp": true },                           // flight key help (F10)

  // Flight keys (pause menu: Settings > Flight keys). Key names: A..Z, 0, F1..F12, F10 excepted,
  // Up, Down, Left, Right, Insert, Delete, Home, End, PageUp, PageDown, Num5, NumPlus, NumMinus,
  // NumMultiply, Space, Enter, Tab, Backspace, Minus, Equals, Backslash, Comma, Period, Slash,
  // Semicolon, Apostrophe, Grave, LeftBracket, RightBracket. Esc, 1-9, Shift, Ctrl and Alt are
  // reserved. A key named twice ends up on the later control.
  "controls": {
    "steerUp": "Up", "steerDown": "Down", "steerLeft": "Left", "steerRight": "Right",
    "rollLeft": "Insert", "rollRight": "Delete", "centreStick": "Num5",
    "throttleUp": "Equals", "throttleDown": "Minus", "fullSpeed": "Backslash", "stop": "Backspace",
    "afterburner": "Tab", "autopilot": "A", "navMap": "N",
    "fireGuns": "Space", "fireMissile": "Enter", "selectGun": "G", "selectMissile": "W",
    "lockTarget": "L", "nextTarget": "T",
    "damageDisplay": "D", "communication": "C", "video": "V", "messageSpeed": "M",
    "formUp": "H", "breakAndAttack": "B",
    "cockpitView": "F1", "leftView": "F2", "rightView": "F3", "rearView": "F4", "chaseView": "F5",
    "battleView": "F6", "targetView": "F7", "missileCamera": "F8", "nextShipView": "F9",
    "pause": "P"
  }
}
