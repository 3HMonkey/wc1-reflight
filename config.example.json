{
  // Copy this file to config.json (which is not committed) and point it to your copy of
  // Wing Commander (the GOG "Wing Commander 1+2" install or its GAMEDAT folder).
  // Windows paths need doubled backslashes; forward slashes work on every platform.
  "gameDirectory": "C:/GOG Games/Wing Commander",

  // Everything below is optional: the game writes it when you change the settings in the
  // pause menu (Esc). Saving rewrites the file without these comments.
  "audio": { "musicVolume": 10, "soundVolume": 10 },          // 0..10
  "display": {
    "fullscreen": false,
    "filter": "sharp",                                       // sharp, nearest, linear
    "aspect": "4:3",                                         // 4:3 or square
    "integerScaling": false,
    "vsync": true
  },
  "text": { "sharp": true, "modernFonts": true },             // text at screen resolution, replacement fonts
  "interface": { "keyHelp": true }                            // flight key help (F10)
}
